rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stocks/{doc} {
      // Public can read stock values
      allow read: if true;
      // Authenticated users can write (development mode; in production, check admin claim)
      allow write: if request.auth != null;
    }

    match /stores/{doc} {
      allow read: if true;
      // Authenticated users can write (development mode; in production, check admin claim)
      allow write: if request.auth != null;
    }

    // Audit logs: only admin can read; functions write via Admin SDK
    match /stock_logs/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
